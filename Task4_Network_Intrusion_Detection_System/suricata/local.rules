# CodeAlpha NIDS lab rules
alert icmp any any -> any any (msg:"LOCAL ICMP Echo Request"; itype:8; sid:1000001; rev:1;)
alert tcp any any -> any 22 (msg:"LOCAL SSH Connection Attempt"; flags:S; sid:1000002; rev:1;)
alert tcp any any -> any any (msg:"LOCAL TCP SYN Probe"; flags:S; flow:stateless; sid:1000003; rev:1;)
